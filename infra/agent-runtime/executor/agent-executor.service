[Unit]
Description=camelAI code executor (gVisor)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/docker rm -f agent-executor
# runsc: guest escapes land in gVisor's user-space kernel, not the host's.
# The environment file holds only AGENT_EXECUTOR_TOKEN. Nothing is mounted from the host.
ExecStart=/bin/sh -c 'exec /usr/bin/docker run --name agent-executor \
  --runtime=runsc \
  --publish 8790:8790 \
  --env-file /opt/agent-executor/executor.env \
  --env AGENT_EXECUTOR_MAX_CONCURRENCY=8 \
  --read-only --tmpfs /tmp:rw,nosuid,nodev,size=256m \
  --cap-drop ALL --security-opt no-new-privileges \
  --pids-limit 512 --memory 1600m \
  --log-opt max-size=20m --log-opt max-file=3 \
  "$(cat /opt/agent-executor/image)" \
  node --experimental-strip-types --disable-warning=ExperimentalWarning src/executor/server.ts'
ExecStop=/usr/bin/docker stop --time 5 agent-executor

[Install]
WantedBy=multi-user.target
