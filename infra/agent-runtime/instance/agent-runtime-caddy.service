[Unit]
Description=camelAI agent runtime TLS proxy
After=docker.service network-online.target agent-runtime.service
Requires=docker.service
Wants=network-online.target

[Service]
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/docker rm -f agent-runtime-caddy
ExecStartPre=-/usr/bin/docker network create agent-runtime
ExecStart=/usr/bin/docker run --name agent-runtime-caddy \
  --network agent-runtime \
  --publish 443:443 \
  --volume /opt/agent-runtime/Caddyfile:/etc/caddy/Caddyfile:ro \
  --volume /opt/agent-runtime/caddy/data:/data \
  --volume /opt/agent-runtime/caddy/config:/config \
  caddy:2.10.2-alpine
ExecStop=/usr/bin/docker stop agent-runtime-caddy

[Install]
WantedBy=multi-user.target
