{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "chiridion-dispatcher-evals",
	"main": "src/index.ts",
	"alias": {
		"virtual:db-query-runner-source": "./src/db-query-runner-source.ts"
	},
	"rules": [
		{ "type": "Text", "globs": ["**/db-query-runner.mjs"], "fallthrough": true }
	],
	"compatibility_date": "2026-07-13",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"AI_VIRTUAL_MODEL": "dynamic/auto",
		"MAIN_APP_URL": "https://staging.camelai.dev",
		// The testing-grounds namespace contains only eval apps and has no shared
		// production identity or registry state.
		"SKIP_AUTH": "true"
	},
	"worker_loaders": [
		{ "binding": "USER_APP_LOADER" }
	],
	"r2_buckets": [
		{ "binding": "R2_BUCKET", "bucket_name": "chiridion-sandbox" }
	],
	"analytics_engine_datasets": [
		{ "binding": "APP_USAGE_AE", "dataset": "chiridion_app_usage_evals" }
	],
	"routes": [
		{ "pattern": "*.apps.evals.camelai.dev/*", "zone_name": "camelai.dev" },
		{ "pattern": "*.evals.camelai.app/*", "zone_name": "camelai.app" }
	],
	"dispatch_namespaces": [
		{
			"binding": "DISPATCHER",
			"namespace": "chiridion-platform-evals"
		}
	],
	"kv_namespaces": [
		{ "binding": "APP_KV", "id": "e894eb2caf1641ad8870da994b992fce" },
		{ "binding": "SESSIONS", "id": "f5ab08fdb1d7404fbc45a171217b4a27" }
	],
	"durable_objects": {
		"bindings": [
			{ "name": "ORG", "class_name": "OrgDO", "script_name": "chiridion-app-staging" },
			{ "name": "WORKER_LOGS", "class_name": "WorkerLogsDO", "script_name": "chiridion-app-staging" },
			{ "name": "TENANT_DO_SUPERVISOR", "class_name": "TenantObjectSupervisorDO" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["TenantObjectSupervisorDO"] }
	]
}
