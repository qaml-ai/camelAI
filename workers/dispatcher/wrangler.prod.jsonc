{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "chiridion-dispatcher",
	"main": "src/index.ts",
	"alias": {
		"virtual:db-query-runner-source": "./src/db-query-runner-source.ts"
	},
	"rules": [
		{ "type": "Text", "globs": ["**/db-query-runner.mjs"], "fallthrough": true }
	],
	"compatibility_date": "2026-07-13",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.1
		}
	},
	"vars": {
		"AI_VIRTUAL_MODEL": "dynamic/auto",
		"MAIN_APP_URL": "https://camelai.dev",
		"CF_GATEWAY_NAME": "chiridion"
	},
	"worker_loaders": [
		{ "binding": "USER_APP_LOADER" }
	],
	"ai": { "binding": "AI", "remote": true },
	"r2_buckets": [
		{ "binding": "R2_BUCKET", "bucket_name": "chiridion-sandbox" }
	],
	"analytics_engine_datasets": [
		{ "binding": "APP_USAGE_AE", "dataset": "chiridion_app_usage_prod" }
	],
	"services": [
		{ "binding": "MAIN_APP_BROKER", "service": "chiridion-app", "entrypoint": "DynamicServiceBroker" }
	],
	"routes": [
		// Cloudflare for SaaS custom hostnames enter the zone under the customer
		// hostname, so a zone-wide route is required for grey-cloud CNAMEs.
		{ "pattern": "*/*", "zone_name": "camelai.app" },
		// Canonical org-scoped iframe hostnames
		{ "pattern": "*.apps.camelai.dev/*", "zone_name": "camelai.dev" },
		{ "pattern": "*.camelai.app/*", "zone_name": "camelai.app" },
		// Fallback origin for Cloudflare for SaaS custom hostnames
		{ "pattern": "custom-domains.camelai.app", "custom_domain": true }
	],
	"dispatch_namespaces": [
		{
			"binding": "DISPATCHER",
			"namespace": "chiridion-platform"
		}
	],
	"kv_namespaces": [
		{ "binding": "APP_KV", "id": "0ee80299e67c4c7fa0c1ad618b7e7a9c" },
		{ "binding": "SESSIONS", "id": "67958a5b0d104621bd93c91c802ccd1c" }
	],
	"durable_objects": {
		"bindings": [
			{ "name": "ORG", "class_name": "OrgDO", "script_name": "chiridion-app" },
			{ "name": "WORKER_LOGS", "class_name": "WorkerLogsDO", "script_name": "chiridion-app" },
			{ "name": "WORKSPACE_FS", "class_name": "WorkspaceFilesystemDO", "script_name": "chiridion-app" },
			{ "name": "TENANT_DO_SUPERVISOR", "class_name": "TenantObjectSupervisorDO" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["TenantObjectSupervisorDO"] }
	]
}
