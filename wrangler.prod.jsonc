{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chiridion-app",
  "main": "build/server/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-04-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
  "limits": {
    "subrequests": 10000000,
    // Monster VM-project migrations (thousands of files hashed + base64d in
    // one request) exceed the default CPU allowance (Cloudflare error 1102).
    "cpu_ms": 300000,
  },
  "tail_consumers": [{ "service": "chiridion-user-logs-tail" }],
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "routes": [{ "pattern": "camelai.dev", "custom_domain": true }],
  "vpc_services": [],
  "vars": {
    "AI_VIRTUAL_MODEL": "google/gemini-3-flash-preview",
    // Static-IP database egress relay (docs/db-egress-relay.md). SOCKS + Access
    // service-token credentials are secrets (DB_EGRESS_RELAY_SOCKS_* /
    // DB_EGRESS_RELAY_ACCESS_*); this hostname is the tunnel public host gost
    // sits behind on the prod sandbox VM (egress from SANDBOX_OUTBOUND_IP
    // 20.46.233.68). Unset ⇒ direct mode (no static IP).
    "DB_EGRESS_RELAY_HOSTNAME": "db-relay.camelai.dev",
    "OPENAI_CODEX_PROXY_BASE_URL": "https://codex-egress.camelai.dev/backend-api/codex",
    "R2_BUCKET_NAME": "chiridion-sandbox",
    "R2_ACCOUNT_ID": "85bbd288051330fb51ee1c86031a299b",
    "R2_PARENT_ACCESS_KEY_ID": "4f8fdc386b4ccb9f4a2bea3c77c8ad95",
    "CF_ACCOUNT_ID": "85bbd288051330fb51ee1c86031a299b",
    "ARTIFACTS_NAMESPACE": "prod",
    "CF_GATEWAY_NAME": "chiridion",
    "CF_DISPATCH_NAMESPACE": "chiridion-platform",
    "WORKER_BASE_URL": "https://camelai.dev",
    "EMAIL_FROM_ADDRESS": "no-reply@mail.camelai.com",
    "WORKSPACE_EMAIL_DOMAIN": "camelai.dev",
    "DISCORD_CHANNEL_ENABLED": "false",
    "DISCORD_CLIENT_ID": "1531387078808436787",
    "STRIPE_MODE": "live",
    "STRIPE_SUBSCRIPTION_PRICE_ID": "price_1TtCX7GvliMKf4vHRVJ6LKLl",
    "STRIPE_STARTER_PRICE_ID": "price_1TtCX7GvliMKf4vHRVJ6LKLl",
    "STRIPE_PRO_PRICE_ID": "price_1TtCXFGvliMKf4vHZNyZsrD0",
    "STRIPE_TEAM_PRICE_ID": "price_1TRzJPGvliMKf4vH3btUUY1d",
    "STRIPE_CREDIT_PRICE_IDS": "price_1TRHq4GvliMKf4vHWeuO0RU9,price_1TRHq5GvliMKf4vHWEfWfoaa,price_1TRHq6GvliMKf4vHqEN0i5iZ,price_1TRHq8GvliMKf4vH1HG70y7N",
    "CF_WORKER_NAME": "chiridion-app",
    "TAIL_WORKER_NAME": "chiridion-user-logs-tail",
    "CF_ZONE_ID": "94f647d6b1658a287820a83d09492c73",
    "CF_CUSTOM_HOSTNAME_FALLBACK": "custom-domains.camelai.app",
    "CF_DCV_DELEGATION_UUID": "1b7fee6764db9b60",
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "build/client",
  },
  "images": { "binding": "IMAGES" },
  "browser": { "binding": "BROWSER" },
  "ai": { "binding": "AI", "remote": true },
  "worker_loaders": [{ "binding": "CODE_MODE_LOADER" }],
  "containers": [
    {
      // Per-org Vite/bun builds with a prewarmed bun cache. standard-3 (2 vCPU /
      // 8 GiB / 16 GB) keeps compile parallelism without standard-4 memory/disk
      // (provisioned-billed while awake; see workers/main/src/container-sizing.ts).
      "class_name": "ProjectBuildSandbox",
      "image": "./workers/main/project-build-sandbox.Dockerfile",
      "instance_type": "standard-3",
      "max_instances": 100,
    },
    {
      // Unified analysis container (notebooks + shell + DuckDB) — successor to
      // the warehouse tier. standard-3 (2 vCPU / 8 GiB / 16 GB) covers typical
      // DuckDB/notebook work without standard-4's provisioned memory/disk cost.
      // The account-wide vCPU quota is shared across all environments and
      // application creation/scale-up is rejected if the requested max_instances
      // would exceed it; 100 × 2 = 200 vCPU fits with headroom. Ceiling is
      // demand-driven, not reserved; scale-to-zero when idle.
      "class_name": "AnalysisSandbox",
      "image": "./workers/main/analysis-sandbox.Dockerfile",
      "instance_type": "standard-3",
      "max_instances": 100,
    },
    {
      // Trusted db-query runner with static-IP egress via the sandbox-host
      // SOCKS relay (docs/db-egress-relay.md). No user code runs here. This is
      // THE SQL query/export path (connection MCP, DATA_PROXY user-app binding,
      // sandbox routes) — one warm container per active workspace, scale-to-zero
      // when idle, so the cap bounds concurrently-querying workspaces
      // (25 × standard-1 = 12.5 vCPU, well under the account container budget).
      "class_name": "DbQuerySandbox",
      "image": "./workers/main/db-query-sandbox.Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 25,
    },
  ],
  "artifacts": [
    { "binding": "ARTIFACTS", "namespace": "prod" },
  ],
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "r2_buckets": [
    { "binding": "R2_BUCKET", "bucket_name": "chiridion-sandbox" },
    // Same bucket as R2_BUCKET under a second binding name: the sandbox SDK
    // refuses to mount one binding at two prefixes, so writable /outputs
    // needs its own binding to coexist with read-only /uploads.
    { "binding": "R2_OUTPUTS_BUCKET", "bucket_name": "chiridion-sandbox" },
    { "binding": "WAREHOUSE_EXPORT_BUCKET", "bucket_name": "chiridion-warehouse-exports" },
  ],
  "analytics_engine_datasets": [
    { "binding": "ERROR_ANALYTICS", "dataset": "chiridion_errors_prod" },
    { "binding": "OBSERVABILITY_EVENTS", "dataset": "chiridion_observability_prod" },
  ],
  // Transcript data lake (config/pipelines/README.md). Streams land in the
  // chiridion-transcript-lake-prod R2 Data Catalog as Iceberg tables.
  "pipelines": [
    { "binding": "TRANSCRIPT_LAKE", "stream": "c3b4395560954073baf658cc22850e03" },
    { "binding": "TOOL_CALLS_LAKE", "stream": "79c4a38bc6134964b1f981734972a622" },
  ],
  "kv_namespaces": [
    { "binding": "EMAIL_TO_USER", "id": "45b452b3b19c42f6991408c140149a70" },
    { "binding": "APP_KV", "id": "0ee80299e67c4c7fa0c1ad618b7e7a9c" },
    { "binding": "SESSIONS", "id": "67958a5b0d104621bd93c91c802ccd1c" },
  ],
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "chiridion-app-db",
      "database_id": "d4e6f5ca-08ec-4920-a4da-5651336beb79",
      "migrations_dir": "migrations",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "APP_SCREENSHOT_QUEUE",
        "queue": "chiridion-app-screenshots",
      },
      {
        "binding": "SLACK_EVENTS_QUEUE",
        "queue": "chiridion-app-slack-events",
      },
    ],
    "consumers": [
      { "queue": "chiridion-app-screenshots" },
      { "queue": "chiridion-app-slack-events" },
      {
        "queue": "chiridion-app-discord-events",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "dead_letter_queue": "chiridion-app-discord-events-dlq"
      },
      {
        "queue": "chiridion-app-discord-events-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 3
      },
    ],
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "chiridion-app" },
    {
      "binding": "DISPATCHER",
      "service": "chiridion-dispatcher"
    },
    { "binding": "DISCORD_BRIDGE", "service": "chiridion-discord-bridge" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_THREAD", "class_name": "ChatThreadDO" },
      { "name": "USER", "class_name": "UserDO" },
      { "name": "SIGNUP", "class_name": "SignupDO" },
      { "name": "ORG", "class_name": "OrgDO" },
      { "name": "ORG_SLUG", "class_name": "OrgSlugDO" },
      { "name": "EMAIL_HANDLE", "class_name": "EmailHandleDO" },
      { "name": "TELEGRAM_REGISTRY", "class_name": "TelegramRegistryDO" },
      { "name": "SLACK_TEAM_REGISTRY", "class_name": "SlackTeamRegistryDO" },
      { "name": "WORKSPACE", "class_name": "WorkspaceDO" },
      { "name": "WORKSPACE_CRON", "class_name": "WorkspaceCronDO" },
      { "name": "MCP_OBJECT", "class_name": "ChiridionMcp" },
	      { "name": "WORKER_LOGS", "class_name": "WorkerLogsDO" },
	      { "name": "WORKSPACE_FS", "class_name": "WorkspaceFilesystemDO" },
	      { "name": "ANALYSIS_SANDBOX", "class_name": "AnalysisSandbox" },
	      { "name": "PROJECT_BUILD_SANDBOX", "class_name": "ProjectBuildSandbox" },
	      { "name": "DB_QUERY_SANDBOX", "class_name": "DbQuerySandbox" },
	    ],
	  },
  "workflows": [
    {
      "name": "chiridion-deterministic-automations-prod",
      "binding": "DETERMINISTIC_AUTOMATION_WORKFLOWS",
      "class_name": "DeterministicAutomationWorkflow"
    }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatDurableObject"] },
    { "tag": "v2", "deleted_classes": ["ChatDurableObject"] },
    { "tag": "v3", "new_sqlite_classes": ["ChatThreadDO", "ChatIndexDO"] },
    { "tag": "v4", "new_sqlite_classes": ["ThreadSandbox"] },
    { "tag": "v5", "new_sqlite_classes": ["SessionDO", "UserDO", "OrgDO"] },
    { "tag": "v6", "new_sqlite_classes": ["WorkspaceDO"] },
    { "tag": "v7", "deleted_classes": ["SessionDO"] },
    { "tag": "v8", "deleted_classes": ["ChatIndexDO"] },
    { "tag": "v9", "new_sqlite_classes": ["ChiridionMcp"] },
    { "tag": "v10", "new_sqlite_classes": ["OrgSlugDO"] },
    { "tag": "v11", "new_sqlite_classes": ["MssqlProxy"] },
    {
      "tag": "v12",
      "deleted_classes": ["MssqlProxy"],
      "new_sqlite_classes": ["DataProxy"],
    },
    { "tag": "v13", "deleted_classes": ["ThreadSandbox"] },
    { "tag": "v14", "new_sqlite_classes": ["WorkerLogsDO"] },
    { "tag": "v15", "new_sqlite_classes": ["AdminIndexDO"] },
    { "tag": "v16", "deleted_classes": ["DataProxy"] },
    { "tag": "v17", "new_sqlite_classes": ["OAuthStateDO"] },
    { "tag": "v18", "new_sqlite_classes": ["WorkspaceCronDO"] },
    { "tag": "v19", "deleted_classes": ["OAuthStateDO"] },
    { "tag": "v20", "new_sqlite_classes": ["EmailHandleDO"] },
    { "tag": "v21", "new_classes": ["EphemeralWorkerLogsDO"] },
    { "tag": "v22", "deleted_classes": ["AdminIndexDO"] },
    { "tag": "v23", "new_sqlite_classes": ["TelegramRegistryDO", "SlackTeamRegistryDO"] },
    { "tag": "v24", "new_sqlite_classes": ["CloudflareSandbox"] },
    { "tag": "v25", "new_sqlite_classes": ["WorkspaceFilesystemDO"] },
	    { "tag": "v27", "new_sqlite_classes": ["MigrationPlanningAgent"] },
    { "tag": "v28", "new_sqlite_classes": ["WarehouseSandbox"] },
	    { "tag": "v29", "new_sqlite_classes": ["ProjectBuildSandbox"] },
	    { "tag": "v30", "new_sqlite_classes": ["AnalysisSandbox"] },
	    { "tag": "v31", "deleted_classes": ["WarehouseSandbox"] },
	    { "tag": "v32", "new_sqlite_classes": ["DbQuerySandbox"] },
	    { "tag": "v33", "new_sqlite_classes": ["SignupDO"] },
	  ],
	}
