{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chiridion-app-staging",
  "main": "build/server/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-03-24",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "limits": {
    "subrequests": 10000000,
    // Monster VM-project migrations (thousands of files hashed + base64d in
    // one request) exceed the default CPU allowance (Cloudflare error 1102).
    "cpu_ms": 300000,
  },
  "tail_consumers": [{ "service": "chiridion-user-logs-tail-staging" }],
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "routes": [{ "pattern": "staging.camelai.dev", "custom_domain": true }],
  "vpc_services": [],
  "vars": {
    "AI_VIRTUAL_MODEL": "dynamic/auto",
    // Static-IP database egress relay (docs/db-egress-relay.md). SOCKS + Access
    // service-token credentials are secrets (DB_EGRESS_RELAY_SOCKS_* /
    // DB_EGRESS_RELAY_ACCESS_*); this hostname is the tunnel public host gost
    // sits behind. Unset ⇒ direct mode (no static IP).
    "DB_EGRESS_RELAY_HOSTNAME": "db-relay-staging.camelai.dev",
    "OPENAI_CODEX_PROXY_BASE_URL": "https://codex-egress-staging.camelai.dev/backend-api/codex",
    "R2_BUCKET_NAME": "chiridion-sandbox",
    "R2_ACCOUNT_ID": "85bbd288051330fb51ee1c86031a299b",
    "R2_PARENT_ACCESS_KEY_ID": "4f8fdc386b4ccb9f4a2bea3c77c8ad95",
    "CF_ACCOUNT_ID": "85bbd288051330fb51ee1c86031a299b",
    "ARTIFACTS_NAMESPACE": "staging",
    "CF_GATEWAY_NAME": "chiridion",
    "CF_DISPATCH_NAMESPACE": "chiridion-platform-staging",
    "WORKER_BASE_URL": "https://staging.camelai.dev",
    "EMAIL_FROM_ADDRESS": "agent-staging@camelai.dev",
    "WORKSPACE_EMAIL_DOMAIN": "camelai.dev",
    "DISCORD_CHANNEL_ENABLED": "false",
    "DISCORD_CLIENT_ID": "1531378050447704264",
    "STRIPE_MODE": "test",
    "STRIPE_SUBSCRIPTION_PRICE_ID": "price_1TtBYWGvliMKf4vH0F0649xi",
    "STRIPE_STARTER_PRICE_ID": "price_1TtBYWGvliMKf4vH0F0649xi",
    "STRIPE_PRO_PRICE_ID": "price_1TtBYXGvliMKf4vHICMV2nnX",
    "STRIPE_TEAM_PRICE_ID": "price_1TS5SpGvliMKf4vHyJUSN3La",
    "STRIPE_CREDIT_PRICE_IDS": "price_1TRIGrGvliMKf4vHdDHs0tYg,price_1TRIGrGvliMKf4vHtX6WouRr,price_1TRIGsGvliMKf4vHWS9HfIkm,price_1TRIGsGvliMKf4vHte5jp64y",

    "CF_WORKER_NAME": "chiridion-app-staging",
    "TAIL_WORKER_NAME": "chiridion-user-logs-tail-staging",
    "CF_ZONE_ID": "94f647d6b1658a287820a83d09492c73",
    "CF_CUSTOM_HOSTNAME_FALLBACK": "custom-domains.staging.camelai.app",
    "CF_DCV_DELEGATION_UUID": "1b7fee6764db9b60",
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "build/client",
  },
  "images": { "binding": "IMAGES" },
  "browser": { "binding": "BROWSER" },
  "ai": { "binding": "AI", "remote": true },
  "worker_loaders": [{ "binding": "CODE_MODE_LOADER" }],
  "containers": [
    {
      "class_name": "ProjectBuildSandbox",
      "image": "./workers/main/project-build-sandbox.Dockerfile",
      "instance_type": "standard-3",
      "max_instances": 25,
    },
    {
      // Unified analysis container — successor to the warehouse tier. Match prod's
      // instance type so staging tests are representative.
      "class_name": "AnalysisSandbox",
      "image": "./workers/main/analysis-sandbox.Dockerfile",
      "instance_type": "standard-3",
      "max_instances": 10,
    },
    {
      // Trusted db-query runner with static-IP egress via the sandbox-host
      // SOCKS relay (docs/db-egress-relay.md). No user code runs here. This is
      // THE SQL query/export path — one warm container per active workspace.
      "class_name": "DbQuerySandbox",
      "image": "./workers/main/db-query-sandbox.Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 10,
    },
  ],
  "artifacts": [
    { "binding": "ARTIFACTS", "namespace": "staging" },
  ],
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "r2_buckets": [
    { "binding": "R2_BUCKET", "bucket_name": "chiridion-sandbox" },
    // Same bucket as R2_BUCKET under a second binding name: the sandbox SDK
    // refuses to mount one binding at two prefixes, so writable /outputs
    // needs its own binding to coexist with read-only /uploads.
    { "binding": "R2_OUTPUTS_BUCKET", "bucket_name": "chiridion-sandbox" },
    { "binding": "WAREHOUSE_EXPORT_BUCKET", "bucket_name": "chiridion-warehouse-exports-staging" },
  ],
  "analytics_engine_datasets": [
    { "binding": "ERROR_ANALYTICS", "dataset": "chiridion_errors_staging" },
    { "binding": "OBSERVABILITY_EVENTS", "dataset": "chiridion_observability_staging" },
  ],
  // Transcript data lake (config/pipelines/README.md). Streams land in the
  // chiridion-transcript-lake-staging R2 Data Catalog as Iceberg tables.
  "pipelines": [
    { "binding": "TRANSCRIPT_LAKE", "stream": "02a2d092797b4903bd1f259752d563d2" },
    { "binding": "TOOL_CALLS_LAKE", "stream": "51df244b1d8f4098adf032cd1c35256f" },
  ],
  "kv_namespaces": [
    { "binding": "EMAIL_TO_USER", "id": "ab267c4f44b847dda8bdca400a4e1884" },
    { "binding": "APP_KV", "id": "e894eb2caf1641ad8870da994b992fce" },
    { "binding": "SESSIONS", "id": "f5ab08fdb1d7404fbc45a171217b4a27" },
  ],
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "chiridion-app-staging-db",
      "database_id": "f73a764a-e6e2-4813-aa5c-6058b0212c51",
      "migrations_dir": "migrations",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "APP_SCREENSHOT_QUEUE",
        "queue": "chiridion-app-screenshots-staging",
      },
      {
        "binding": "SLACK_EVENTS_QUEUE",
        "queue": "chiridion-app-slack-events-staging",
      },
    ],
    "consumers": [
      { "queue": "chiridion-app-screenshots-staging" },
      { "queue": "chiridion-app-slack-events-staging" },
      {
        "queue": "chiridion-app-discord-events-staging",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "dead_letter_queue": "chiridion-app-discord-events-dlq-staging"
      },
      {
        "queue": "chiridion-app-discord-events-dlq-staging",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 3
      },
    ],
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "chiridion-app-staging" },
    {
      "binding": "DISPATCHER",
      "service": "chiridion-dispatcher-staging"
    },
    { "binding": "DISCORD_BRIDGE", "service": "chiridion-discord-bridge-staging" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_THREAD", "class_name": "ChatThreadDO" },
      { "name": "USER", "class_name": "UserDO" },
      { "name": "SIGNUP", "class_name": "SignupDO" },
      { "name": "ORG", "class_name": "OrgDO" },
      { "name": "ORG_SLUG", "class_name": "OrgSlugDO" },
      { "name": "EMAIL_HANDLE", "class_name": "EmailHandleDO" },
      { "name": "TELEGRAM_REGISTRY", "class_name": "TelegramRegistryDO" },
      { "name": "SLACK_TEAM_REGISTRY", "class_name": "SlackTeamRegistryDO" },
      { "name": "WORKSPACE", "class_name": "WorkspaceDO" },
      { "name": "WORKSPACE_CRON", "class_name": "WorkspaceCronDO" },
	      { "name": "MCP_OBJECT", "class_name": "ChiridionMcp" },
	      { "name": "WORKER_LOGS", "class_name": "WorkerLogsDO" },
	      { "name": "WORKSPACE_FS", "class_name": "WorkspaceFilesystemDO" },
	      { "name": "ANALYSIS_SANDBOX", "class_name": "AnalysisSandbox" },
	      { "name": "PROJECT_BUILD_SANDBOX", "class_name": "ProjectBuildSandbox" },
	      { "name": "DB_QUERY_SANDBOX", "class_name": "DbQuerySandbox" },
	    ],
	  },
  "workflows": [
    {
      "name": "chiridion-deterministic-automations-staging",
      "binding": "DETERMINISTIC_AUTOMATION_WORKFLOWS",
      "class_name": "DeterministicAutomationWorkflow"
    }
  ],
  "migrations": [
    { "tag": "v27" },
    { "tag": "v28" },
    { "tag": "v29", "new_sqlite_classes": ["TelegramRegistryDO", "SlackTeamRegistryDO"] },
	    { "tag": "v30", "new_sqlite_classes": ["WorkspaceFilesystemDO"] },
    { "tag": "v31", "new_sqlite_classes": ["MigrationPlanningAgent"] },
    { "tag": "v32", "new_sqlite_classes": ["WarehouseSandbox"] },
	    { "tag": "v33", "new_sqlite_classes": ["ProjectBuildSandbox"] },
	    { "tag": "v34", "new_sqlite_classes": ["AnalysisSandbox"] },
	    { "tag": "v35", "deleted_classes": ["WarehouseSandbox"] },
	    { "tag": "v36", "new_sqlite_classes": ["DbQuerySandbox"] },
	    { "tag": "v37", "new_sqlite_classes": ["SignupDO"] },
	  ],
	}
