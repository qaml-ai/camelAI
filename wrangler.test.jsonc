{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chiridion-app-test",
	"main": "workers/main/src/index.ts",
	"compatibility_date": "2026-03-24",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
	// Notebook deploys read the pre-built renderer SPA (public/notebook-renderer/,
	// bun run build:renderer) through ASSETS; run-agent-eval.mjs ensures it's built.
	"assets": { "binding": "ASSETS", "directory": "./public" },
	"dev": { "container_engine": "unix:///tmp/camelai-docker-fuse.sock" },
	"worker_loaders": [{ "binding": "CODE_MODE_LOADER" }],
	"browser": { "binding": "BROWSER" },
	"containers": [
		{
			"class_name": "EvalSandbox",
			"image": "./workers/main/eval-sandbox.Dockerfile",
			"instance_type": "lite",
			"max_instances": 1
		},
		{
			"class_name": "ProjectBuildSandbox",
			"image": "./workers/main/project-build-sandbox.Dockerfile",
			"instance_type": "standard-3",
			"max_instances": 1
		},
		{
			"class_name": "AnalysisSandbox",
			"image": "./workers/main/analysis-sandbox.Dockerfile",
			"instance_type": "standard-3",
			"max_instances": 1
		}
	],
	"send_email": [{ "name": "EMAIL" }],
	"services": [],
	"vars": {
		"AI_VIRTUAL_MODEL": "dynamic/auto",
		"DISCORD_CHANNEL_ENABLED": "false",
		"CF_ACCOUNT_ID": "85bbd288051330fb51ee1c86031a299b",
		"CF_GATEWAY_NAME": "chiridion",
		"TOKEN_SIGNING_SECRET": "test-signing-secret-for-unit-tests-only",
		"INTEGRATION_SECRET_KEY": "test-secret-key-for-integration-tests",
		// Real-deploy evals (on by default when CF_API_TOKEN is set; opt out with
		// EVAL_REAL_DEPLOY=0) target this testing-grounds dispatch namespace, served by the
		// evals dispatcher at *.evals.camelai.app. CF_WORKER_NAME is the deployed worker that
		// exposes the virtual-binding entrypoints (reuses the staging main worker). The
		// LOCAL_APP_* hosts make getAppUrl emit the testing-grounds URL through the normal
		// app path, so list_apps/set_preview need no eval-specific code.
		"CF_DISPATCH_NAMESPACE": "chiridion-platform-evals",
		"CF_WORKER_NAME": "chiridion-app-staging",
		"WORKER_BASE_URL": "https://evals.camelai.dev",
		"LOCAL_APP_VANITY_DOMAIN": "evals.camelai.app",
		"LOCAL_APP_IFRAME_DOMAIN": "apps.evals.camelai.dev"
	},
	"kv_namespaces": [
		{
			"binding": "EMAIL_TO_USER",
			"id": "test-email-to-user"
		},
		{
			"binding": "APP_KV",
			"id": "test-api-tokens"
		},
		{
			"binding": "SESSIONS",
			"id": "test-sessions"
		}
	],
	"r2_buckets": [
		{ "binding": "R2_BUCKET", "bucket_name": "chiridion-sandbox-test" },
		// Same bucket as R2_BUCKET, under a second binding name. The sandbox SDK
		// refuses to mount one binding at two prefixes, so the writable /outputs
		// mount needs its own binding to coexist with read-only /uploads.
		{ "binding": "R2_OUTPUTS_BUCKET", "bucket_name": "chiridion-sandbox-test" }
	],
	"d1_databases": [
		{
			"binding": "APP_DB",
			"database_name": "chiridion-app-test-db",
			"database_id": "test-app-db",
			"migrations_dir": "migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "CHAT_THREAD", "class_name": "ChatThreadDO" },
			{ "name": "EVAL_SANDBOX", "class_name": "EvalSandbox" },
			{ "name": "USER", "class_name": "UserDO" },
			{ "name": "SIGNUP", "class_name": "SignupDO" },
			{ "name": "ORG", "class_name": "OrgDO" },
			{ "name": "ORG_SLUG", "class_name": "OrgSlugDO" },
			{ "name": "EMAIL_HANDLE", "class_name": "EmailHandleDO" },
			{ "name": "TELEGRAM_REGISTRY", "class_name": "TelegramRegistryDO" },
				{ "name": "SLACK_TEAM_REGISTRY", "class_name": "SlackTeamRegistryDO" },
				{ "name": "WORKSPACE", "class_name": "WorkspaceDO" },
				{ "name": "WORKSPACE_CRON", "class_name": "WorkspaceCronDO" },
				{ "name": "WORKSPACE_FS", "class_name": "WorkspaceFilesystemDO" },
				{ "name": "PROJECT_BUILD_SANDBOX", "class_name": "ProjectBuildSandbox" },
				{ "name": "ANALYSIS_SANDBOX", "class_name": "AnalysisSandbox" },
				{ "name": "WORKER_LOGS", "class_name": "WorkerLogsDO" }
			]
		},
	"workflows": [
		{
			"name": "chiridion-deterministic-automations-test",
			"binding": "DETERMINISTIC_AUTOMATION_WORKFLOWS",
			"class_name": "DeterministicAutomationWorkflow"
		}
	],
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["UserDO", "OrgDO", "OrgSlugDO", "WorkspaceDO", "EmailHandleDO"] },
		{ "tag": "v2", "new_sqlite_classes": ["AdminIndexDO"] },
		{ "tag": "v3", "new_sqlite_classes": ["OAuthStateDO"] },
		{ "tag": "v4", "new_sqlite_classes": ["WorkspaceCronDO"] },
		{ "tag": "v5", "deleted_classes": ["OAuthStateDO"] },
		{ "tag": "v6", "deleted_classes": ["AdminIndexDO"] },
		{ "tag": "v7", "new_sqlite_classes": ["TelegramRegistryDO", "SlackTeamRegistryDO"] },
			{ "tag": "v8", "new_sqlite_classes": ["WorkspaceFilesystemDO"] },
			{ "tag": "v9", "new_sqlite_classes": ["MigrationPlanningAgent"] },
			{ "tag": "v10", "new_sqlite_classes": ["Sandbox", "ChatThreadDO"] },
			{ "tag": "v11", "new_sqlite_classes": ["EvalSandbox"] },
			{ "tag": "v12", "new_sqlite_classes": ["ProjectBuildSandbox"] },
			{ "tag": "v13", "new_sqlite_classes": ["AnalysisSandbox"] },
			{ "tag": "v14", "new_sqlite_classes": ["SignupDO"] },
			{ "tag": "v15", "new_sqlite_classes": ["WorkerLogsDO"] }
		]
	}
